{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lattix",
  "version": "0.1.0",
  "identifier": "lattix.local",
  "build": {
    "frontendDist": "../build/",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "lattix",
        "width": 1600,
        "height": 900,
        "minWidth": 800,
        "minHeight": 450,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../static/lattix-icon.svg"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
