{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lattix",
  "identifier": "lattix",
  "build": {
    "frontendDist": "../build/",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "lattix",
        "width": 1600,
        "height": 900,
        "minWidth": 800,
        "minHeight": 450,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-GB"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
